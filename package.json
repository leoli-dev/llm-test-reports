{
  "name": "llm-test-reports",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal LLM test reports: Markdown source and a static HTML/JS archive for GitHub Pages",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/validate.mjs",
    "preview": "python3 -m http.server 8437 --directory dist --bind 127.0.0.1"
  },
  "engines": {"node": ">=22"},
  "devDependencies": {"marked": "18.1.1", "sanitize-html": "2.18.1"}
}
